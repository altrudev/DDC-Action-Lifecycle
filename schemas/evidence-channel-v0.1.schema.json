{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altru.dev/ddc/schemas/evidence-channel-v0.1.schema.json",
  "title": "DDC Action Lifecycle Evidence Channel v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "channel_id",
    "state",
    "visible_to"
  ],
  "properties": {
    "profile": {"const": "ddc.evidence-channel.v1"},
    "channel_id": {"type": "string", "minLength": 1},
    "state": {
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "STALE",
        "UNREACHABLE",
        "UNTRUSTED",
        "UNKNOWN"
      ]
    },
    "visible_to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "delivery_latency_ms": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "max_delivery_latency_ms": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "source_id": {"type": ["string", "null"]},
    "provenance_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
